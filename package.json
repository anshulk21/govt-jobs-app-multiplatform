{
  "name": "govt-jobs-finder",
  "version": "0.1.0",
  "private": true,
  "description": "All-India government jobs app (Android, iOS, web) with an automated monitor of official recruitment pages.",
  "engines": {
    "node": ">=22.3"
  },
  "scripts": {
    "start": "npm run build:api:sample && expo start",
    "android": "npm run build:api:sample && expo start --android",
    "ios": "npm run build:api:sample && expo start --ios",
    "web": "npm run build:api:sample && expo start --web",
    "build:api": "tsx scripts/build-api.ts",
    "build:api:sample": "SAMPLE_JOBS=1 tsx scripts/build-api.ts",
    "build:web": "npm run build:api && expo export --platform web && tsx scripts/postbuild-web.ts",
    "monitor": "tsx scripts/monitor/index.ts",
    "monitor:local": "tsx scripts/monitor/index.ts --only-failing --push",
    "validate-sources": "tsx scripts/validate-sources.ts",
    "verify-sources": "tsx scripts/verify-sources.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:web:sample": "npm run build:api:sample && SAMPLE_JOBS=1 expo export --platform web && SAMPLE_JOBS=1 tsx scripts/postbuild-web.ts",
    "push:published": "tsx scripts/push/notify-published.ts",
    "push:reminders": "tsx scripts/push/daily-reminders.ts"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "babel-preset-expo": "~58.0.0",
    "firebase-admin": "^14.5.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/app": "27.0.0",
    "@react-native-firebase/messaging": "27.0.0",
    "cheerio": "^1.2.0",
    "expo": "~58.0.16",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.12",
    "expo-dev-client": "~58.0.14",
    "expo-file-system": "~58.0.10",
    "expo-font": "~58.0.9",
    "expo-image-manipulator": "~58.0.15",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.13",
    "expo-notifications": "~58.1.5",
    "expo-router": "~58.0.24",
    "expo-sharing": "~58.0.19",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.6",
    "expo-web-browser": "~58.0.6",
    "firebase": "12.19.0",
    "lucide-react": "1.52.0",
    "lucide-react-native": "1.52.0",
    "nativewind": "4.2.7",
    "pdf-parse": "^2.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "undici": "^7.30.1"
  },
  "main": "expo-router/entry"
}
